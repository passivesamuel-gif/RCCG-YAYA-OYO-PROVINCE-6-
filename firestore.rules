rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is an authorized administrator for RCCG YAYA OYO 6
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------
    // 1. Books Collection
    // Readers must be authenticated to browse and read.
    // Administrators upload, edit, or delete books.
    // -------------------------------------------------------------
    match /books/{bookId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------
    // 2. User Profiles & Reading Progress
    // Readers can manage their own profile and private reading progress.
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.role == 'member' && request.resource.data.uid == userId;
      allow update: if isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'email', 'createdAt']));
      allow delete: if false;

      match /progress/{bookId} {
        allow read, write: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------
    // 3. Protected Admins Collection
    // -------------------------------------------------------------
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Default Deny
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
